{
  "name": "redesmyn-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "api:spec": "uv run --directory .. python scripts/export_openapi.py",
    "api:gen": "openapi-typescript ../openapi/openapi.json -o src/api/v1.ts",
    "api:update": "npm run api:spec && npm run api:gen",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --react-plugin --tsconfig tsconfig.json .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "openapi-typescript": "^7.10.0",
    "oxfmt": "^0.2.0",
    "oxlint": "^1.16.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "npm:rolldown-vite@^6.3.21"
  }
}
