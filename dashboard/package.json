{
  "name": "redesmyn-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --react-plugin --tsconfig tsconfig.json .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "oxfmt": "^0.2.0",
    "oxlint": "^1.16.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "npm:rolldown-vite@^6.3.21"
  }
}
