# Copy to `.env` (this file is gitignored) and fill in values.
#
# Create a Linear OAuth app and set the redirect URL to:
#   http://127.0.0.1:9234/v1/linear/oauth/callback
#
# Then set:
REDESMYN_LINEAR_CLIENT_ID=
REDESMYN_LINEAR_CLIENT_SECRET=

# Optional:
# REDESMYN_API_HOST=127.0.0.1
# REDESMYN_API_PORT=9234
# REDESMYN_DAEMON_AUTH_TOKEN=dev
# REDESMYN_LINEAR_SCOPES=read
