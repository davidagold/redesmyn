amends "package://github.com/jdx/hk/releases/download/v1.28.0/hk@1.28.0#/Config.pkl"

local formatters = new Mapping<String, Step> {
    ["ruff_format"] {
        glob = List("**/*.py", "**/*.pyi")
        stage = List("**/*.py", "**/*.pyi")
        check = "uv run ruff format --check {{files}}"
        fix = "uv run ruff format {{files}}"
    }

    ["oxfmt"] {
        glob = List(
            "dashboard/**/*.ts",
            "dashboard/**/*.tsx",
            "dashboard/**/*.js",
            "dashboard/**/*.jsx",
            "dashboard/**/*.json",
        )
        stage = List(
            "dashboard/**/*.ts",
            "dashboard/**/*.tsx",
            "dashboard/**/*.js",
            "dashboard/**/*.jsx",
            "dashboard/**/*.json",
        )
        check = "dashboard/node_modules/.bin/oxfmt --check {{files}}"
        fix = "dashboard/node_modules/.bin/oxfmt {{files}}"
    }
}

local precommit_steps = (formatters) {
    ["openapi_types"] {
        glob = List(
            "redesmyn/api.py",
            "redesmyn/api/**/*.py",
            "redesmyn/schemas/**/*.py",
            "openapi/openapi.json",
            "dashboard/src/api/v1.ts",
        )
        fix = "npm --prefix dashboard run api:update && dashboard/node_modules/.bin/oxfmt dashboard/src/api/v1.ts"
        stage = List(
            "dashboard/src/api/v1.ts",
            "openapi/openapi.json",
        )
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        stage = true
        steps = precommit_steps
    }

    ["fix"] {
        fix = true
        steps = formatters
    }

    ["check"] {
        steps = formatters
    }
}
