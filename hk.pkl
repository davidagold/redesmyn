amends "package://github.com/jdx/hk/releases/download/v1.28.0/hk@1.28.0#/Config.pkl"

local formatters = new Mapping<String, Step> {
    ["ruff_format"] {
        glob = List("**/*.py", "**/*.pyi")
        stage = List("**/*.py", "**/*.pyi")
        check = "uv run ruff format --check {{files}}"
        fix = "uv run ruff format {{files}}"
    }

    ["oxfmt"] {
        glob = List(
            "dashboard/**/*.ts",
            "dashboard/**/*.tsx",
            "dashboard/**/*.js",
            "dashboard/**/*.jsx",
            "dashboard/**/*.mjs",
        )
        stage = List(
            "dashboard/**/*.ts",
            "dashboard/**/*.tsx",
            "dashboard/**/*.js",
            "dashboard/**/*.jsx",
            "dashboard/**/*.mjs",
        )
        check = "dashboard/node_modules/.bin/oxfmt --check {{files}}"
        fix = "dashboard/node_modules/.bin/oxfmt {{files}}"
    }
}

local precommit_steps = (formatters) {
    ["openapi_types"] {
        glob = List(
            "redesmyn/api.py",
            "redesmyn/api/**/*.py",
            "redesmyn/schemas/**/*.py",
            "openapi/openapi.json",
            "dashboard/src/api/v1.ts",
        )
        dir = "dashboard"
        fix = "npm run api:update && node_modules/.bin/oxfmt src/api/v1.ts"
        stage = List(
            "dashboard/src/api/v1.ts",
            "openapi/openapi.json",
        )
    }

    ["dashboard_packaged_assets"] {
        glob = List(
            "dashboard/src/**",
            "dashboard/public/**",
            "dashboard/index.html",
            "dashboard/vite.config.ts",
            "dashboard/tailwind.config.ts",
            "dashboard/components.json",
            "dashboard/tsconfig*.json",
            "dashboard/package.json",
            "dashboard/package-lock.json",
        )
        dir = "dashboard"
        fix = "npm run build && uv run python ../scripts/build_packaged_dashboard_assets.py --copy-only"
        stage = List("redesmyn/dashboard_assets/dist/**")
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        stage = true
        steps = precommit_steps
    }

    ["fix"] {
        fix = true
        steps = formatters
    }

    ["check"] {
        steps = formatters
    }
}
